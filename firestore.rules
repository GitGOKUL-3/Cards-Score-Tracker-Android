rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Enforce strict user-scoped data isolation
    // Allows full access to games, rounds, and metadata only if authenticated user owns the document path
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny rule for any unstructured collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
